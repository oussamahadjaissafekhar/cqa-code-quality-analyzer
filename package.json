{
  "name": "cqa-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Code Quality Analyzer - Python CLI with TypeScript parsers",
  "workspaces": [
    "packages/shared",
    "packages/parser-core",
    "packages/parser-cli"
  ],
  "scripts": {
    "build": "npm run build -w @cqa/shared && npm run build -w @cqa/parser-core && npm run build -w @cqa/parser-cli",
    "clean": "npm run clean --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "jest --config tests/ts/jest.config.cjs",
    "test:ts": "jest --config tests/ts/jest.config.cjs"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
