{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cqa.local/schemas/finding.schema.json",
  "title": "Finding",
  "description": "A single rule verdict anchored to a source location. Schema v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rule_id",
    "severity",
    "message",
    "path",
    "start_line",
    "start_col",
    "end_line",
    "end_col",
    "fingerprint"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "rule_id": { "type": "string", "minLength": 1 },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info"]
    },
    "message": { "type": "string", "minLength": 1 },
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "POSIX-style path relative to the analysis root"
    },
    "start_line": { "type": "integer", "minimum": 1 },
    "start_col": { "type": "integer", "minimum": 1 },
    "end_line": { "type": "integer", "minimum": 1 },
    "end_col": { "type": "integer", "minimum": 1 },
    "fingerprint": { "type": "string", "pattern": "^cqa:v1:[0-9a-f]{16}$" },
    "snippet": { "type": "string", "description": "Bounded source excerpt (max 4 KiB)" },
    "help_uri": { "type": "string" }
  }
}
